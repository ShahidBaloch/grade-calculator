NEXT_PUBLIC_SITE_URL=https://www.gradcalc.com
NEXT_PUBLIC_CONTACT_EMAIL=hello@gradcalc.com

# Contact form — SMTP (recommended; same pattern as FancifyText / FancyText)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your@gmail.com
# SMTP_PASS=your-app-password
# Local check (same vars in .env.local): npm run verify:contact-smtp
# Leave CONTACT_TO unset. Gmail SMTP delivers to SMTP_USER+gradcalc@gmail.com
# so the message stays in Inbox when hello@ forwards back to the same Gmail.
# CONTACT_TO=hello@gradcalc.com
# Optional From — only after Gmail “Send mail as” for hello@gradcalc.com is verified.
# CONTACT_FROM=hello@gradcalc.com

# Alternative: Resend API (used when SMTP is not configured)
# RESEND_API_KEY=
# CONTACT_FROM_EMAIL=GradeCalculator <noreply@gradcalc.com>
