{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    // Type-check against React's types (the code is written for them); Vite runs it on
    // preact/compat. lucide-react is installed for its types only; builds use lucide-preact.
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "allowJs": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "next/link": ["./src/shims/next-link.tsx"],
      "next/navigation": ["./src/shims/next-navigation.ts"],
      "next/dynamic": ["./src/shims/next-dynamic.tsx"],
      "next-themes": ["./src/shims/next-themes.tsx"],
      "next": ["./src/shims/next.ts"]
    }
  },
  "include": [".astro/types.d.ts", "**/*"],
  // worker/ has its own tsconfig (Cloudflare Workers types instead of the DOM).
  "exclude": ["node_modules", "dist", ".vercel", ".cloudflare", ".wrangler", "coverage", "worker"]
}
