{
  "name": "grade-calculator",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/vercel-routes.ts",
    "start": "node scripts/serve-static.mjs",
    "check": "astro check",
    "lint": "astro check",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:chromium": "playwright test --project=chromium",
    "playwright:install": "playwright install chromium",
    "test:a11y": "playwright test e2e/accessibility.spec.ts --project=chromium",
    "test:mobile": "playwright test e2e/mobile.spec.ts --project=mobile-chrome --project=mobile-safari",
    "test:lighthouse": "npm run build && lhci autorun",
    "test:qa": "npm run build && npm run test:coverage && npm run test:e2e:chromium",
    "verify:contact-smtp": "node --env-file=.env.local scripts/verify-contact-smtp.mjs",
    "push:gradecalc": "powershell -ExecutionPolicy Bypass -File scripts/push-gradecalc.ps1",
    "submit:discovery": "powershell -ExecutionPolicy Bypass -File scripts/submit-bing-yandex.ps1",
    "cf:dev": "wrangler dev",
    "cf:deploy": "wrangler deploy",
    "cf:check": "tsc -p worker"
  },
  "dependencies": {
    "@astrojs/preact": "^6.1.1",
    "@astrojs/vercel": "^11.0.17",
    "@radix-ui/react-slot": "^1.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.4.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-preact": "^1.65.0",
    "nodemailer": "^10.0.10",
    "preact": "^10.29.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "zod": "^4.6.4"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@axe-core/playwright": "^4.10.2",
    "@cloudflare/workers-types": "^5.20261031.1",
    "@lhci/cli": "^0.14.0",
    "@playwright/test": "^1.51.0",
    "@types/node": "^22.20.2",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^5.0.0",
    "jsdom": "^30.0.1",
    "lucide-react": "^1.65.0",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "vitest": "^5.0.0",
    "wrangler": "^4.156.0"
  },
  "browserslist": [
    "chrome >= 111",
    "edge >= 111",
    "firefox >= 111",
    "safari >= 16.4",
    "ios_saf >= 16.4"
  ],
  "type": "module"
}
